#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" != refs/heads/main ] || [ "$local_ref" = '(delete)' ]; then
        continue
    fi

    head=$(git rev-parse HEAD)
    if [ "$head" != "$local_sha" ]; then
        echo "Check out the commit you want to push to main." >&2
        exit 1
    fi
    changes=$(git status --porcelain --untracked-files=normal --ignore-submodules=none)
    if [ -n "$changes" ]; then
        echo "Commit or stash your changes before pushing to main." >&2
        exit 1
    fi

    make preflight </dev/null
done
